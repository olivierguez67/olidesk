<!--
  Deployment configuration dialog, shown between the install-directory dialog
  and the "ready to install" dialog. Only compiled in when the installer was
  built with the api_url and deploy_token flags (see ../../preprocess.py),
  e.g. the client build, not the admin build.

  Collects a device name (defaulting to this machine's hostname) and the
  target address-book group, then WriteDeployJson (see ../Components/
  RustDesk.wxs and ../../CustomActions/DeployConfig.cpp) writes
  olidesk-deploy.json into the install folder so the app self-registers on
  first launch (see flutter/lib/common/olidesk_deploy.dart) instead of
  needing that file dropped in by hand after install.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <?include ../Includes.wxi?>
    <?ifdef ApiUrl?>
    <Fragment>
        <UI>
            <Dialog Id="DeployConfigDlg" Width="370" Height="270" Title="Deployment Configuration">
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg" />
                </Control>

                <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="Name this device and choose the group it should register under in the address book." />
                <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="Deployment Configuration" />
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

                <Control Id="DeviceNameLabel" Type="Text" X="20" Y="60" Width="290" Height="15" NoPrefix="yes" Text="Device name" />
                <Control Id="DeviceNameEdit" Type="Edit" X="20" Y="76" Width="320" Height="18" Property="DEVICENAME" />

                <Control Id="GroupLabel" Type="Text" X="20" Y="104" Width="290" Height="15" NoPrefix="yes" Text="Client group: pick an existing one below, or type a new name" />
                <!-- Intentionally editable (ComboList="no", the WiX default): typing a
                     name that isn't in the list creates it on the server (see
                     _get_or_create_top_level_group in olidesk-api/app.py), which covers
                     both the "New group..." entry and the API-unreachable fallback with
                     one control instead of two. Populated at runtime by the FetchGroups
                     custom action; see the DoAction publish on MyInstallDirDlg's Next
                     button in ../UI/MyInstallDlg.wxs. -->
                <Control Id="GroupCombo" Type="ComboBox" X="20" Y="120" Width="320" Height="18" Property="GROUP" ComboList="no" Sorted="yes">
                    <!-- WiX only emits the ComboBox table into the compiled MSI when
                         a static item is authored somewhere; with none, FetchGroups'
                         runtime INSERT INTO ComboBox fails at install time with error
                         2205 ("table does not exist") since the table is simply absent.
                         This placeholder exists purely to make WiX include the table;
                         FetchGroups deletes it (and re-inserts real rows) before the
                         user ever sees this dialog, so it's never actually shown. -->
                    <ComboBox Property="GROUP">
                        <ListItem Text=" " Value=" " />
                    </ComboBox>
                </Control>

                <!-- A conditionally shown "server unreachable" hint here would need
                     WiX v4's real syntax for per Control visibility conditions, which
                     this codebase has no working precedent for (a first attempt using
                     WiX v3's Condition Action="show"/"hide" child element form failed
                     to compile: "unexpected child element 'Condition'"). Skipped
                     rather than guess again: GroupLabel above already states the
                     field is free text either way, which is the actual requirement
                     ("install never blocks"); this was only the nice to have part. -->
            </Dialog>
        </UI>
    </Fragment>
    <?endif?>
</Wix>
